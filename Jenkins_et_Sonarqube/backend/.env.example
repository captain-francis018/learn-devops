# ============================================================
# EXEMPLE DE CONFIGURATION BACKEND
# Copiez ce fichier en .env et modifiez les valeurs
# ============================================================

# ── BASE DE DONNÉES ─────────────────────────────────────────
# URI de connexion MongoDB
# Local : mongodb://localhost:27017/portfolio
# Docker : mongodb://mongodb:27017/portfolio
# Cloud : mongodb+srv://user:password@cluster.mongodb.net/portfolio
MONGODB_URI=mongodb://localhost:27017/portfolio

# ── SERVEUR ─────────────────────────────────────────────────
# Port sur lequel le serveur Express écoute
PORT=5000

# ── CORS ────────────────────────────────────────────────────
# Origine autorisée pour les requêtes CORS
# Dev local avec Vite : http://localhost:5173
# Dev Docker : http://localhost
# Production : https://votre-domaine.com
CORS_ORIGIN=http://localhost:5173
