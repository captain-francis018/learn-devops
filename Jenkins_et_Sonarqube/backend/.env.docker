# ============================================================
# CONFIGURATION BACKEND POUR DOCKER
# Utilisé automatiquement par docker-compose.yml
# ============================================================

# MongoDB tourne dans un conteneur Docker avec le nom "mongodb"
# Docker résout automatiquement ce nom via son DNS interne
MONGODB_URI=mongodb://mongodb:27017/portfolio

# Port du serveur Express
PORT=5000

# Le frontend tourne sur nginx qui écoute sur le port 80
# En production Docker, autoriser toutes les origines ou spécifier le domaine
CORS_ORIGIN=http://localhost
